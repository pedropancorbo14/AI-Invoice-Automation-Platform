    {
      "type": "stat",
      "id": 5,
      "title": "Coste de IA",
      "description": "Suma del coste de cada extracción con IA. No incluye las correcciones manuales.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "facturas-pg"
