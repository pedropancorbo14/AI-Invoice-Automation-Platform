      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "facturas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH docs AS (\n    SELECT account_id, count(*) AS n, max(created_at) AS last_at\n    FROM documents WHERE $__timeFilter(created_at) GROUP BY 1\n), val AS (\n    SELECT account_id, count(*) FILTER (WHERE user_id IS NULL) AS auto, count(*) AS total\n    FROM document_events\n    WHERE type = 'status_changed' AND to_status = 'validated' AND $__timeFilter(created_at) GROUP BY 1\n), ai AS (\n    SELECT account_id, sum(cost_usd) AS cost, avg(cost_usd) AS avg_cost\n    FROM document_extractions WHERE input_mode <> 'manual' AND $__timeFilter(created_at) GROUP BY 1\n)\nSELECT a.name AS \"Cuenta\",\n       (SELECT count(*) FROM companies c WHERE c.account_id = a.id) AS \"Empresas\",\n       (SELECT count(*) FROM users u WHERE u.account_id = a.id) AS \"Usuarios\",\n       coalesce(docs.n, 0) AS \"Documentos\",\n       round(100.0 * val.auto / NULLIF(val.total, 0), 1) AS \"% automático\",\n       (SELECT count(*) FROM documents p WHERE p.account_id = a.id AND p.status = 'needs_review') AS \"Pendientes\",\n       coalesce(ai.cost, 0) AS \"Coste IA\",\n       ai.avg_cost AS \"Coste por documento\",\n       docs.last_at AS \"Último documento\"\nFROM accounts a\nLEFT JOIN docs ON docs.account_id = a.id\nLEFT JOIN val ON val.account_id = a.id\nLEFT JOIN ai ON ai.account_id = a.id\nWHERE a.id IN ($account)\nORDER BY \"Coste IA\" DESC, a.name"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
