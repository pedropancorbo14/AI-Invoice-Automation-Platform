          "rawSql": "SELECT x.created_at AS \"Fecha\", a.name AS \"Cuenta\", x.target AS \"Destino\", x.document_id AS \"Documento\",\n       x.attempts AS \"Intentos\", x.error AS \"Error\"\nFROM document_exports x JOIN accounts a ON a.id = x.account_id\nWHERE x.status = 'failed' AND $__timeFilter(x.created_at) AND x.account_id IN ($account)\nORDER BY x.created_at DESC LIMIT 50"
