        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
