    {
      "type": "stat",
      "id": 7,
      "title": "Coste previsto del mes",
      "description": "Lo gastado en lo que va de mes, extrapolado al mes completo. No depende del periodo elegido.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "facturas-pg"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "facturas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0)\n       / EXTRACT(day FROM now() AT TIME ZONE 'UTC')\n       * EXTRACT(day FROM date_trunc('month', now() AT TIME ZONE 'UTC') + interval '1 month - 1 day') AS \"Previsto\"\nFROM document_extractions\nWHERE input_mode <> 'manual' AND created_at >= date_trunc('month', now() AT TIME ZONE 'UTC') AND account_id IN ($account)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
