          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(created_at, '1d', 0),\n       CASE source WHEN 'email' THEN 'Email' WHEN 'upload' THEN 'Subida manual' ELSE source END AS metric,\n       count(*) AS value\nFROM documents\nWHERE $__timeFilter(created_at) AND account_id IN ($account)\nGROUP BY 1, 2 ORDER BY 1"
