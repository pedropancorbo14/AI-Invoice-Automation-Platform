          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE status\n    WHEN 'received' THEN 'Recibido' WHEN 'classified' THEN 'Clasificado' WHEN 'extracted' THEN 'Extraído'\n    WHEN 'validated' THEN 'Validado' WHEN 'exported' THEN 'Exportado' WHEN 'needs_review' THEN 'En revisión'\n    WHEN 'ignored' THEN 'Ignorado' WHEN 'failed' THEN 'Fallido' ELSE status END AS \"Estado\", count(*) AS \"Documentos\"\nFROM documents WHERE $__timeFilter(created_at) AND account_id IN ($account)\nGROUP BY 1 ORDER BY 2 DESC"
