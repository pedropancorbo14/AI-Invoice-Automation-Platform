          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE status\n    WHEN 'pending' THEN 'Pendiente' WHEN 'processed' THEN 'Procesado' WHEN 'no_documents' THEN 'Sin adjuntos'\n    WHEN 'unrouted' THEN 'Sin destinatario' WHEN 'forwarding_confirmation' THEN 'Confirmación de reenvío'\n    WHEN 'failed' THEN 'Fallido' ELSE status END AS \"Estado\", count(*) AS \"Correos\"\nFROM inbound_emails WHERE $__timeFilter(created_at) AND (account_id IS NULL OR account_id IN ($account))\nGROUP BY 1 ORDER BY 2 DESC"
