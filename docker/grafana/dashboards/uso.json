            "type": "grafana-postgresql-datasource",
            "uid": "facturas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE code\n    WHEN 'required' THEN 'Faltan datos' WHEN 'currency' THEN 'Otra moneda' WHEN 'tax_id' THEN 'CIF/NIF no válido'\n    WHEN 'dates' THEN 'Fechas' WHEN 'tax_rates' THEN 'Tipos de IVA' WHEN 'arithmetic' THEN 'El total no cuadra'\n    WHEN 'direction' THEN 'No es de este cliente' WHEN 'confidence' THEN 'Datos dudosos'\n    WHEN 'duplicate' THEN 'Posible duplicado' WHEN 'new_supplier' THEN 'Proveedor nuevo'\n    WHEN 'link_invoice' THEN 'Factura por enlace' WHEN 'unreadable' THEN 'No se puede leer'\n    WHEN 'ai_refused' THEN 'La IA no lo procesó' WHEN 'not_invoice' THEN 'Albarán o presupuesto'\n    WHEN 'no_data' THEN 'Sin datos extraídos' WHEN 'export_failed' THEN 'Error al exportar' ELSE code END AS \"Motivo\", count(*) AS \"Veces\"\nFROM document_events e, json_array_elements_text(e.payload -> 'review_codes') AS code\nWHERE e.type = 'status_changed' AND e.to_status = 'needs_review' AND $__timeFilter(e.created_at) AND e.account_id IN ($account)\nGROUP BY 1 ORDER BY 2 DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "fillOpacity": 80
          }
        },
        "overrides": []
      },
