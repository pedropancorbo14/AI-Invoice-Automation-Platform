          "rawSql": "SELECT CASE input_mode WHEN 'text' THEN 'Texto del PDF' WHEN 'pdf' THEN 'PDF escaneado' WHEN 'image' THEN 'Imagen' ELSE input_mode END AS \"Entrada\",\n       count(*) AS \"Extracciones\", avg(cost_usd) AS \"Coste medio\", sum(cost_usd) AS \"Coste total\"\nFROM document_extractions WHERE input_mode <> 'manual' AND $__timeFilter(created_at) AND account_id IN ($account)\nGROUP BY 1 ORDER BY 4 DESC"
