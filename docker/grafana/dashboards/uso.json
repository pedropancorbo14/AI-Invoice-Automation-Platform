            "uid": "facturas-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(sum(cost_usd), 0) AS \"Coste\" FROM document_extractions WHERE input_mode <> 'manual' AND $__timeFilter(created_at) AND account_id IN ($account)"
        }
