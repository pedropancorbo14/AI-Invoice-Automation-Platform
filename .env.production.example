# Producción (o demo pública). Copia a .env en el servidor y rellena.
APP_NAME="Facturas IA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_DOMAIN=facturas.tudominio.com
APP_URL=https://facturas.tudominio.com
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# true para una demo pública: credenciales en el login, sin Holded, se
# reinicia cada noche. false con datos reales.
DEMO_MODE=false

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=invoices
DB_USERNAME=invoices
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="facturas@tudominio.com"
MAIL_FROM_NAME="${APP_NAME}"

DOCUMENTS_DISK=documents

INBOX_ENABLED=false
INBOX_ADDRESS=facturas@tudominio.com
INBOX_IMAP_HOST=
INBOX_IMAP_USERNAME=
INBOX_IMAP_PASSWORD=

ANTHROPIC_API_KEY=
EXTRACTION_ENABLED=true
EXTRACTION_MODEL=claude-opus-5-5
EXTRACTION_EFFORT=medium

EXPORT_ENABLED=true

OPERATOR_EMAILS=

# Grafana (perfil "grafana", ver docs/grafana.md). Contraseñas largas y
# aleatorias, distintas entre sí y de DB_PASSWORD.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_DB_PASSWORD=
